---
interface Props {
  job: string;
  job_description: string;
  company: string;
  company_info: string;
  from: string;
  to: string;
  link?: string;
}

const { job, job_description, company, company_info, from, to, link } =
  Astro.props;
---

<article
  class="flex border-1 p-4 justify-between rounded-lg border border-gray-600 bg-gray-800 animated-border cursor-pointer gap-2"
>
  <div class="basis-1/2">
    <h3 class="text-4xl font-semibold text-yellow-200">
      {company}
    </h3>
    <p>
      {company_info}
    </p>
  </div>
  <div class="basis-1/2">
    <h4 class="text-3xl">
      {job}
    </h4>
    <p>
      {job_description}
    </p>
    <div class="flex flew-row gap-1 mb-1 justify-end text-sm font-normal leading-none text-gray-500">
      <time class="mb-1 text-sm font-normal leading-none text-gray-500">
        {from}
      </time>
      -
      <time class="mb-1 text-sm font-normal leading-none text-gray-500">
        {to}
      </time>
    </div>
  </div>
</article>
