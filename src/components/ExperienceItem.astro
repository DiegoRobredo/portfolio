---
import ExternalLink from "@/icons/ExternalLink.astro";

interface Props {
  job: string;
  job_description: string;
  company: string;
  company_info: string;
  from: string;
  to: string;
  link?: string;
}

const { job, job_description, company, company_info, from, to, link } =
  Astro.props;
---

<a
  class="responsive-grid experience-item border-1 p-4 justify-between rounded-lg border border-gray-600 bg-gray-800 animated-border cursor-pointer gap-4"
  rel="noopener noreferrer"
  target="_blank"
  href={link}
>
  <div>
    <div class="flex flex-row items-center">
      <h3 class="text-4xl font-semibold text-yellow-200">
        {company}
      </h3>
      <ExternalLink class="ml-4 external-link" />
    </div>
    <p class="text-lg">
      {company_info}
    </p>
  </div>
  <div>
    <h4 class="text-2xl font-semibold text-gray-400">
      {job}
    </h4>
    <p class="text-lg">
      {job_description}
    </p>
    <div
      class="flex flew-row gap-1 mb-1 justify-end text-sm font-normal leading-none text-gray-500"
    >
      <time class="mb-1 text-sm font-normal leading-none text-gray-500">
        {from}
      </time>
      -
      <time class="mb-1 text-sm font-normal leading-none text-gray-500">
        {to}
      </time>
    </div>
  </div>
</a>

<style>
  .experience-item {
    opacity: 0.8;
    transition: all 0.3s ease;
  }
  .experience-item:hover {
    opacity: 1;
    transform: translate(10px);
  }
  .external-link {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .experience-item:hover .external-link {
    opacity: 0.7;
  }

  .responsive-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }
</style>
