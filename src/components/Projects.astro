---
import TechIcon from "@/components/TechIcon.astro";

const TAGS = {
  HTML: {
    name: "HTML",
    class: "bg-orange-600 text-white",
    icon: "HTMLIcon"
  },
  CSS: {
    name: "CSS",
    class: "bg-sky-600 text-white",
    icon: "CSSIcon"
  },
  REACT: {
    name: "React",
    class: "bg-cyan-600 text-white",
    icon: "ReactIcon"
  },
  AWS: {
    name: "AWS",
    class: "bg-orange-400 text-white",
    icon: "AWSIcon"
  },
  FIGMA: {
    name: "Figma",
    class: "bg-white text-white",
    icon: "FigmaIcon"
  }
};

const PROJECTS = [
  {
    title: "OHLIVE",
    description:
      "Mobile application for presenting a 3D product catalog in Augmented Reality. Developed from scratch using React. Cloud architecture implemented using AWS services",
    image: "/images/Ohlive.webp",
    repository: "",
    url: "",
    tags: [TAGS.HTML, TAGS.CSS, TAGS.AWS, TAGS.REACT]
  },
  {
    title: "Mobile application design",
    description:
      "Interface design for a mobile application developed with Figma. Interactions between different screens and elements of the application are prototyped",
    image: "/images/Prototype.webp",
    repository: "",
    url: "",
    tags: [TAGS.FIGMA]
  }
];
---

{
  PROJECTS.map(({ title, description, image, repository, tags, url }) => (
    <article class="flex flex-col md:flex-row gap-x-4 gap-y-2 py-4">
      <div class="img-hover-zoom row-span-full overflow-hidden rounded shadow-2xl shadow-white/20 ">
        <img
          alt={`Captura de pantalla del proyecto "${title}"`}
          class="img-hover-zoom self-center w-full aspect-video"
          src={image}
        />
      </div>
      <div class="flex flex-col gap-y-2">
        <h3 class="text-xl font-semibold text-yellow-200">{title}</h3>
        <p class="text-md text-pretty">{description}</p>
        <ul class="flex gap-x-2">
          {tags.map(({ name: title, icon }) => (
            <li class="mr-4">
              <TechIcon icon={icon} class="size-8" />
            </li>
          ))}
        </ul>
        <footer class="flex gap-x-4">
          {url && <button>Preview</button>}
          {repository && <button>Github</button>}
        </footer>
      </div>
    </article>
  ))
}

<style>
  .img-hover-zoom img {
    transition: transform 0.5s;
  }
  .img-hover-zoom:hover img {
    transform: scale(1.2);
  }

  .responsive-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
  }
</style>
