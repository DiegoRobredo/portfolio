---
import HTMLIcon from "@/icons/html-logo.astro";
import CSSIcon from "@/icons/css-logo.astro";
import AWSIcon from "@/icons/aws-logo.astro";
import ReactIcon from "@/icons/react-logo.astro";
import FigmaIcon from "@/icons/figma-logo.astro";

const { icon } = Astro.props;
---

{icon === "HTMLIcon" && <HTMLIcon {...Astro.props} />}
{icon === "CSSIcon" && <CSSIcon {...Astro.props} />}
{icon === "AWSIcon" && <AWSIcon {...Astro.props} />}
{icon === "ReactIcon" && <ReactIcon {...Astro.props} />}
{icon === "FigmaIcon" && <FigmaIcon {...Astro.props} />}
