---
import ProfessinoalLink from "@/components/ProfessinoalLink.astro";
import SocialPill from "@/components/SocialPill.astro";
import GitHubIcon from "@/icons/GitHub.astro";
import LinkedInIcon from "@/icons/LinkedIn.astro";
import MailIcon from "@/icons/Mail.astro";
---

<h1 class="text-clamp-[2rem-10vw-8rem] leading-none font-bold mb-4">
  Frontend <span class="gradient-text">Developer</span> & Software Engineer
</h1>
<h2 class="text-xl text-wrap w-[70%]">
  Hi! I'm Diego Robredo, a Frontend Developer continuously learning and focused
  on JavaScript frameworks to breathe life into web applications.
</h2>
<nav class="flex gap-4 mt-8 flex-wrap">
  <SocialPill href="https://www.linkedin.com/in/diegorobredo/">
    <LinkedInIcon class="size-8 md:size-6" />
    LinkedIn
  </SocialPill>
  <SocialPill href="https://github.com/DiegoRobredo">
    <GitHubIcon class="size-2 md:size-6" />
    GitHub
  </SocialPill>
  <SocialPill href="mailto:drobredo@gmail.com">
    <MailIcon class="size-2 md:size-6" />
    Email
  </SocialPill>
</nav>
