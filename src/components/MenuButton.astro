<button
  data-menu-button
  class="menu-button flex flex-col border-0 w-[1.95rem] h-[1.95rem] bg-transparent gap-[0.55rem]"
>
  <div></div>
  <div></div>
  <div></div>
</button>

<script>
  const button = document.querySelector("[data-menu-button]");
  const menuOverflow = document.querySelector("div[data-menu-overflow]");

  button.addEventListener("click", () => {
    if (button.classList.contains("button-cross")) {
      button.classList.remove("button-cross");
    } else {
      button.classList.add("button-cross");
    }

    if (menuOverflow.classList.contains("menu-overflow-shown")) {
      menuOverflow.classList.remove("menu-overflow-shown");
    } else {
      menuOverflow.classList.add("menu-overflow-shown");
    }
  });
</script>

<style>
  @media (width >= 768px) {
    .menu-button {
      display: none;
    }
  }

  .menu-button {
    z-index: 2;
  }

  .button-cross div:first-child {
    transform: rotate(45deg);
  }

  .button-cross div:last-child {
    transform: rotate(-45deg);
  }

  .button-cross div:nth-child(2) {
    opacity: 0;
  }

  .menu-button div {
    background-color: #d1d5db;
    width: 100%;
    height: 2px;
    border-radius: 5px;
    transition: all 0.5s;
    transform-origin: left;
  }
</style>
