---
import { NAV_ITEMS } from "@/utils/constants";
import MenuButton from "./MenuButton.astro";
---

<header
  class="fixed backdrop-blur top-0 z-10 flex justify-center items-center py-6 w-full mx-auto px-4"
>
  <nav class="flex flex-row py-1 justify-between items-center w-full max-w-6xl">
    <div class="flex flex-row items-center space-x-4">
      <img
        class="rounded-full size-12 object-cover"
        src="/profile.webp"
        alt="Diego Robredo photo"
      />
      <a href="/#" class="text-xl font-bold"
        ><span class="whitespace-nowrap">Diego</span><span class="block"
          >Robredo</span
        ></a
      >
    </div>
    <div
      data-menu-overflow
      class="menu-overflow justify-center space-y-5 md:space-y-0 md:space-x-10 items-center"
    >
      {
        NAV_ITEMS.map((link) => (
          <a
            aria-label={link.label}
            href={link.url}
            class="text-3xl md:text-lg md:font-normal font-semibold md:gradient-hover"
            data-nav-link
          >
            {link.title}
          </a>
        ))
      }
    </div>
    <MenuButton />
  </nav>
</header>

<script>
  const navLinks = document.querySelectorAll("[data-nav-link]");
  const menuOverflow = document.querySelector("div[data-menu-overflow]");
  const button = document.querySelector("[data-menu-button]");

  navLinks.forEach((link) => {
    link.addEventListener("click", () => {
      button.classList.remove("button-cross");
      menuOverflow.classList.remove("menu-overflow-shown");
    });
  });
</script>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section");
    const navItems = document.querySelectorAll("header nav a");

    const callback = (entries: any[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && entry.target.id) {
          navItems.forEach((item) => {
            if (item.getAttribute("aria-label") == entry.target.id) {
              item.classList.add("gradient-text");
            } else {
              item.classList.remove("gradient-text");
            }
          });
        }
      });
    };

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "-40% 0px -40% 0px",
      threshold: 0
    });

    sections.forEach((section) => {
      observer.observe(section);
    });

    // Cleanup function
    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        sections.forEach((section) => {
          observer.observe(section);
        });
      }
    };
  });
</script>

<style>
  @media (width <= 768px) {
    .menu-overflow {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      height: 100dvh;
      background-color: var(--background);
      width: 100vw;
      position: absolute;
      top: 0;
      left: 0;
      transform: translate(100%);
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .menu-overflow-shown {
      transform: translate(0);
    }
  }

  @media (width > 768px) {
    .menu-overflow {
      display: flex;
      flex-direction: row;
      gap: 1rem;
    }
  }
</style>
