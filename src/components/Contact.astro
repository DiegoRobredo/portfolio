<form
  action="https://formsubmit.co/drobredo@gmail.com"
  method="POST"
  class="flex flex-col gap-4"
>
  <div class="flex flex-row gap-2 w-full">
    <input
      type="text"
      placeholder="TU NOMBRE"
      name="name"
      required
      class="p-2 bg-gray-800"
    />
    <input
      type="email"
      placeholder="TU EMAIL"
      name="email"
      required
      class="p-2 flex-grow-2 bg-gray-800"
    />
  </div>
  <button type="submit" class="p-2 bg-blue-500">Send</button>
</form>
