---
import Layout from "@/layouts/Layout.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import Experience from "@/components/Experience.astro";
import Projects from "@/components/Projects.astro";
import SocialPill from "@/components/SocialPill.astro";
import GitHubIcon from "@/icons/GitHub.astro";
import LinkedInIcon from "@/icons/LinkedIn.astro";
import MailIcon from "@/icons/Mail.astro";
import BriefCaseIcon from "@/icons/BriefCase.astro";
import CodeIcon from "@/icons/Code.astro";
import ProfileCheck from "@/icons/ProfileCheck.astro";
import AboutMe from "@/components/AboutMe.astro";
import Contact from "@/components/Contact.astro";
import Introductory from "@/components/Introductory.astro";
---

<Layout
  title="Portfolio de Diego Robredo - Desarrollador y Programador Web con 7 años de experiencia"
  description="Desarrollador web Frontend especializado en JavaScript. Me encanta enfrentarme a cualquier desafío de programación. Explora mi portfolio para ver cómo convierto ideas en realidad a través de código creativo y soluciones innovadoras"
>
  <main class="px-4">
    <SectionContainer class="pt-24 pb-32 my-16" id="home">
      <Introductory />

      <nav class="flex gap-4 mt-8 flex-wrap">
        <SocialPill href="https://www.linkedin.com/in/diegorobredo/">
          <LinkedInIcon class="size-8 md:size-6" />
          LinkedIn
        </SocialPill>
        <SocialPill href="https://github.com/DiegoRobredo">
          <GitHubIcon class="size-2 md:size-6" />
          GitHub
        </SocialPill>
        <SocialPill href="mailto:drobredo@gmail.com">
          <MailIcon class="size-2 md:size-6" />
          drobredo@gmail.com
        </SocialPill>
      </nav>
    </SectionContainer>

    <div>
      <SectionContainer id="experiencia" class="pb-16 my-16">
        <h2 class="text-6xl font-semibold mb-6 flex gap-x-3 items-center">
          Experience
        </h2>
        <Experience />
      </SectionContainer>

      <SectionContainer id="proyectos" class="pb-16 my-16">
        <h2 class="text-6xl font-semibold mb-6 flex gap-x-3 items-center">
          Projects
        </h2>
        <Projects />
      </SectionContainer>
      <SectionContainer id="sobre-mi" class="pb-16 my-16">
        <h2 class="text-6xl font-semibold mb-6 flex gap-x-3 items-center">
          About me
        </h2>
        <AboutMe />
      </SectionContainer>
      <SectionContainer id="contacto" class="pb-16 my-16">
        <h2 class="text-2xl font-semibold mb-6 flex gap-x-3 items-center">
          Contact
        </h2>
        <Contact />
      </SectionContainer>
    </div>
  </main>
</Layout>
