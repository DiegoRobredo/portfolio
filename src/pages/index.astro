---
import Layout from "@/layouts/Layout.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import Experience from "@/components/Experience.astro";
import Projects from "@/components/Projects.astro";
import AboutMe from "@/components/AboutMe.astro";
import Contact from "@/components/Contact.astro";
import Introductory from "@/components/Introductory.astro";
---

<Layout
  title="Diego Robredo's Portfolio - Frontend Developer & Software Engineer"
  description="Frontend Web Developer specialized in JavaScript. I love tackling any programming challenge. Explore my portfolio to see how I turn ideas into reality through creative code and innovative solutions"
>
  <main class="px-4">
    <SectionContainer class="pt-24 pb-32 mt-16 mb-32" id="home">
      <Introductory />
    </SectionContainer>

    <div>
      <SectionContainer id="experiencia" class="pb-16 mb-40">
        <h2
          class="text-5xl md:text-6xl font-semibold mb-6 flex gap-x-3 items-center"
        >
          Experience
        </h2>
        <Experience />
      </SectionContainer>

      <SectionContainer id="proyectos" class="pb-16 mb-40">
        <h2
          class="text-5xl md:text-6xl font-semibold mb-6 flex gap-x-3 items-center"
        >
          Projects
        </h2>
        <Projects />
      </SectionContainer>
      <SectionContainer id="sobre-mi" class="pb-16 mb-40">
        <h2
          class="text-5xl md:text-6xl font-semibold mb-6 flex gap-x-3 items-center"
        >
          About me
        </h2>
        <AboutMe />
      </SectionContainer>
    </div>
  </main>
</Layout>
