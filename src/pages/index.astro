---
import Layout from "@/layouts/Layout.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import Experience from "@/components/Experience.astro";
import Projects from "@/components/Projects.astro";
import AboutMe from "@/components/AboutMe.astro";
import Contact from "@/components/Contact.astro";
import Introductory from "@/components/Introductory.astro";
---

<Layout
  title="Portfolio de Diego Robredo - Desarrollador y Programador Web con 7 años de experiencia"
  description="Desarrollador web Frontend especializado en JavaScript. Me encanta enfrentarme a cualquier desafío de programación. Explora mi portfolio para ver cómo convierto ideas en realidad a través de código creativo y soluciones innovadoras"
>
  <main class="px-4">
    <SectionContainer class="pt-24 pb-32 mt-16 mb-32" id="home">
      <Introductory />
    </SectionContainer>

    <div>
      <SectionContainer id="experiencia" class="pb-16 mb-40">
        <h2 class="text-6xl font-semibold mb-6 flex gap-x-3 items-center">
          Experience
        </h2>
        <Experience />
      </SectionContainer>

      <SectionContainer id="proyectos" class="pb-16 mb-40">
        <h2 class="text-6xl font-semibold mb-6 flex gap-x-3 items-center">
          Projects
        </h2>
        <Projects />
      </SectionContainer>
      <SectionContainer id="sobre-mi" class="pb-16 mb-40">
        <h2 class="text-6xl font-semibold mb-6 flex gap-x-3 items-center">
          About me
        </h2>
        <AboutMe />
      </SectionContainer>
    </div>
  </main>
</Layout>
