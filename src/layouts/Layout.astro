---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { description, title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>

    <meta name="theme-color" content="#09f" />
    <link rel="icon" type="image/svg+xml" href="/images/profile.webp" />
    <link
      rel="preload"
      href="/fonts/Onest-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/Onest-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/Onest-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <!-- HTML Meta Tags -->
    <title>
      Diego Robredo's Portfolio - Frontend Developer & Software Engineer
    </title>
    <meta
      name="description"
      content="Frontend Web Developer specialized in JavaScript. I love tackling any programming challenge. Explore my portfolio to see how I turn ideas into reality through creative code and innovative solutions"
    />

    <!-- Facebook Meta Tags -->
    <meta property="og:url" content="https://diegorobredo.com/" />
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Diego Robredo's Portfolio - Frontend Developer & Software Engineer"
    />
    <meta
      property="og:description"
      content="Frontend Web Developer specialized in JavaScript. I love tackling any programming challenge. Explore my portfolio to see how I turn ideas into reality through creative code and innovative solutions"
    />
    <meta property="og:image" content="https://diegorobredo.com/images/card_image.webp" />
    <meta property="og:site_name" content="Diego Robredo's Portfolio" />

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="diegorobredo.com" />
    <meta property="twitter:url" content="https://diegorobredo.com/" />
    <meta
      name="twitter:title"
      content="Diego Robredo's Portfolio - Frontend Developer & Software Engineer"
    />
    <meta
      name="twitter:description"
      content="Frontend Web Developer specialized in JavaScript. I love tackling any programming challenge. Explore my portfolio to see how I turn ideas into reality through creative code and innovative solutions"
    />
    <meta name="twitter:image" content="https://diegorobredo.com/images/card_image.webp" />
  </head>
</html>
<body class="font-mono">
  <div
    class="absolute inset-0 -z-10 h-full w-full bg-neutral-950 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"
  >
  </div><Header />
  <slot />
  <Footer />
</body>

<style is:global>
  body {
    @apply font-mono;
  }
  :root {
    color-scheme: dark;
    --gradient: linear-gradient(to right, #4a6bff, #00ff85);
    --background: #0a0a0a;
    --text: #ffffff;
    --accent: #00ff85;
  }

  .gradient-text,
  .gradient-hover:hover {
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @media (width > 768px) {
    .gradient-hover-md:hover {
      background: var(--gradient);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
  }

  html {
    font-family: "Onest Variable", system-ui, sans-serif;
    scroll-behavior: smooth;
  }
  body {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
